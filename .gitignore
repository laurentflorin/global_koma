# Secrets -- never commit.
.Renviron

# Raw and cached data -- never commit; refetch/rebuild instead.
data/raw/*
data/cache/*
data/outputs/*
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/outputs/.gitkeep

# renv project library -- restored from renv.lock with renv::restore().
renv/library/
renv/local/
renv/cellar/
renv/lockfile.lock
renv/python/
renv/sandbox/
renv/staging/

# The local store of the archived targets pipeline, if one is still on disk.
_targets/

# R session/package build artifacts.
.Rproj.user/
.Rhistory
.RData
.Rbuildignore.bak
*.Rcheck/
inst/doc/
man/*.Rd.bak
NAMESPACE.bak

/.quarto/
**/*.quarto_ipynb
