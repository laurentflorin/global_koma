# Secrets -- never commit.
.Renviron

# Raw and cached data -- never commit; refetch/rebuild instead.
data/raw/*
data/cache/*
!data/raw/.gitkeep
!data/cache/.gitkeep

# renv project library -- restored from renv.lock with renv::restore().
renv/library/
renv/local/
renv/cellar/
renv/lockfile.lock
renv/python/
renv/sandbox/
renv/staging/

# targets pipeline store -- rebuild with targets::tar_make().
_targets/
_targets_r/

# R session/package build artifacts.
.Rproj.user/
.Rhistory
.RData
.Rbuildignore.bak
*.Rcheck/
inst/doc/
man/*.Rd.bak
NAMESPACE.bak

# Rendered reports ARE committed. They are the only way to read this project's
# results without the cached fits, which are 1.3 GB of koma posterior draws and
# stay git-ignored above. Every report sets `embed-resources: true`, so each
# .html is self-contained and no `_files/` sidecar is ever produced -- the rule
# below is a guard in case one ever renders without embedding.
reports/*_files/
docs/*.html

/.quarto/
**/*.quarto_ipynb
